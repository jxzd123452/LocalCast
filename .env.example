# Copy to .env if you want defaults. Flags override these values.
# Do not put a room token here. Tokens are generated per session and are not read from the environment.

# TCP port for the local server.
PORT=8787

# Interface to bind. 0.0.0.0 listens on every local interface so phones can connect.
# Use 127.0.0.1 to keep the server on this computer only.
BIND_HOST=0.0.0.0

# IPv4 address encoded in the QR code. Leave empty to pick the first LAN address.
ADVERTISE_HOST=

# 15m, 1h, or unlimited
TTL=unlimited

# true or false. Uploads are off unless you opt in.
UPLOAD_ENABLED=false

# Byte cap for a single upload. Default is 200 MiB.
MAX_UPLOAD_BYTES=209715200

# Optional folder to share immediately at startup.
SHARE_ROOT=
